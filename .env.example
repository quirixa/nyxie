# Copy to .env and fill in. Never commit the real .env.

# REQUIRED. At least 32 characters, not a placeholder. The server refuses to
# start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
PORT=3000
# Move all on-disk data (SQLite files, uploads, avatars, banners). Default: ./data
# NYXIE_DATA_DIR=./data
# Max members per group chat
# GROUP_MAX_MEMBERS=
# Wallet limits
# WALLET_MAX_TRANSFER_NX=
# WALLET_MAX_DAILY_TRANSFER_NX=
# WALLET_MAX_TRANSFERS_PER_MIN=
# Optional. Key for the opaque reporter reference shown in the Developer workspace
# instead of a user's identity. Defaults to JWT_SECRET. Changing it only changes
# the reference shown on NEW reports (existing reports keep theirs).
# REPORT_REF_SECRET=
# Enables /api/dev test-funding routes. NEVER enable in production.
# ENABLE_DEV_ROUTES=true
